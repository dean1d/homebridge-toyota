{
  "pluginAlias": "Toyota",
  "pluginType": "accessory",
  "singular": true,
  "customUi": true,
  "schema": {
    "type": "object",
    "required": [
      "name",
      "vin"
    ],
    "properties": {
      "name": {
        "type": "string",
        "default": "Sienna"
      },
      "vin": {
        "type": "string",
        "pattern": "^[A-HJ-NPR-Z0-9]{17}$",
        "title": "Vehicle VIN"
      },
      "showDoorLock": {
        "type": "boolean",
        "title": "Show door lock and unlock",
        "default": true
      },
      "showRemoteStart": {
        "type": "boolean",
        "title": "Show remote start",
        "default": true
      }
    }
  }
}
